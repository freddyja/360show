# Vercel Blob read-write token. Guest QR cloud share and laptop remote song upload.
# Production (and Preview) must use a **new** Hobby store — not the suspended
# 360show-blob / store_QGVEYIOJLDEadPj8 store (paused until ~2026-10-17).
# Create Storage → Blob in the Vercel dashboard, connect it, then `vercel env pull`.
# If the store is suspended, the booth still works (local download, phone songs).
# Remote pairing uses Runtime Cache and does not need this token.
BLOB_READ_WRITE_TOKEN=
# Optional. public | private. Must match the Blob store access mode.
# New Vercel stores are often private; a public put against a private store fails.
# If unset, the app probes with a tiny put (no Blob `list` / Advanced Ops).
BLOB_ACCESS=

# Public site origin used in QR / copy / SMS (no trailing slash).
# Example: https://360show.vercel.app
# If unset on Vercel, the app falls back to https://$VERCEL_URL.
NEXT_PUBLIC_APP_URL=

# Google Drive OAuth (optional). Used when Settings → Cloud destination is Google Drive.
# Create a Web application OAuth client in Google Cloud Console (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. Default is {NEXT_PUBLIC_APP_URL or request origin}/api/drive/callback
GOOGLE_REDIRECT_URI=
