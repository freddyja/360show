# Vercel Blob read-write token (optional). Used only when the store is healthy.
# Guest QR sharing and laptop song upload prefer Cloudflare R2 when Blob is
# suspended or missing. Do not create another Blob store.
# If the store is suspended, the app keeps the booth working without Blob
# (local download, phone custom songs). Remote pairing can use R2 or Runtime Cache.
BLOB_READ_WRITE_TOKEN=
# Optional. public | private. Must match the Blob store access mode.
# New Vercel stores are often private; a public put against a private store fails.
# If unset, the app detects access (existing objects, then public-then-private probe).
BLOB_ACCESS=

# Cloudflare R2 (recommended while Blob is suspended). S3-compatible object store
# for guest share videos, remote operator JSON, and laptop songs.
# Create a bucket + API token in Cloudflare, then set these on Vercel for
# Production AND Preview (Development optional for local).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional public bucket / custom domain URL (no trailing slash), e.g.
# https://media.example.com  — used for guest video links. If unset, guests
# stream through /api/share/[clipId]/file.
R2_PUBLIC_BASE_URL=

# Public site origin used in QR / copy / SMS (no trailing slash).
# Example: https://360show.vercel.app
# If unset on Vercel, the app falls back to https://$VERCEL_URL.
NEXT_PUBLIC_APP_URL=

# Google Drive OAuth (optional). Used when Settings → Cloud destination is Google Drive.
# Create a Web application OAuth client in Google Cloud Console (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. Default is {NEXT_PUBLIC_APP_URL or request origin}/api/drive/callback
GOOGLE_REDIRECT_URI=
